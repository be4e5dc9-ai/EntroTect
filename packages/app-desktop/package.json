{
  "name": "@entrotect/app-desktop",
  "version": "0.7.2",
  "description": "EntroTect - Windows 濡楀矂娼?Coding Agent",
  "author": "EntroTect",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @entrotect/shared build && pnpm --filter @entrotect/core build && pnpm build && electron .",
    "build": "pnpm vite build && pnpm typecheck && pnpm esbuild:main",
    "build:min": "pnpm vite build && pnpm esbuild:main:min",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "esbuild:main": "esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "esbuild:main:min": "esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --minify --outdir=dist --out-extension:.js=.cjs",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@entrotect/core": "workspace:*",
    "@entrotect/shared": "workspace:*",
    "@fontsource/inter": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "highlight.js": "^11.11.0",
    "markdown-it": "^14.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.entrotect.app",
    "productName": "EntroTect",
    "artifactName": "EntroTect-Setup-${version}.${ext}",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EntroTect",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
